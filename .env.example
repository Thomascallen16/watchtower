# Watchtower local/recovery configuration template
# Copy to a local secret store or managed environment. Never commit actual values.

# Runtime and data
NODE_ENV=development
PORT=3000
DATABASE_URL=
JWT_SECRET=
OAUTH_SERVER_URL=
VITE_APP_ID=
OWNER_OPEN_ID=

# Managed Forge/storage integration
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Optional official integrations
# Do not configure a value unless an approved provider integration is being implemented.
HIBP_API_KEY=
TRACKER_INTELLIGENCE_API_KEY=
TOKEN_REFERENCE_KEY_VERSION=
